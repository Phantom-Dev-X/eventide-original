# Pterodactyl / panel — local disk only. Do NOT copy Render's Supabase keys here.
# Render keeps SUPABASE_URL + SUPABASE_KEY. This box uses the persistent volume.

USE_SUPABASE=false
AUTO_UPDATE=true
# Leave these empty on the panel (or omit them):
# SUPABASE_URL=
# SUPABASE_KEY=

PORT=3000
MAX_USERS=10
HOST=0.0.0.0

# Optional
# TELEGRAM_TOKEN=
# DEV_TELEGRAM_IDS=
# DEV_NUMBERS=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROUP_CHANNEL_LINK=
# ALLOWED_ORIGINS=https://your-site.vercel.app

# Persist these folders/files on the volume:
#   sessions/
#   web_users.json
#   web_id_sessions.json
#   user_map.json
